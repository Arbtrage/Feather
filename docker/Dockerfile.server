FROM rust:1.83-bookworm AS builder
WORKDIR /app
COPY packages/server/Cargo.toml packages/server/build.rs packages/server/config ./packages/server/
COPY packages/server/src ./packages/server/src
COPY packages/proto ./packages/proto
COPY Cargo.toml ./
WORKDIR /app/packages/server
RUN cargo build --release

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=builder /app/packages/server/target/release/feather-server /usr/local/bin/feather-server
COPY packages/server/config/default.toml /app/config/default.toml
ENV FEATHER_REDIS_URL=redis://redis:6379
EXPOSE 50051 8080
CMD ["feather-server"]
